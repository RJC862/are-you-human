# Luminal Cloud API (DeepSeek / GLM Flash) — OpenAI-compatible chat completions.
# Used ONLY server-side (in /api/text) to phrase challenge instructions and the
# result-screen explanation. The app works without these (hardcoded fallbacks);
# all face/hand liveness detection runs on-device in the browser.
LUMINAL_API_KEY=your_luminal_api_key_here
LUMINAL_BASE_URL=https://api.luminal.ai/v1
LUMINAL_MODEL=deepseek-chat
